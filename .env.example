# SwipeAI Environment Configuration

# --- Hardware & Connection ---
# The ADB address of your Android device/emulator
ADB_DEVICE=192.168.240.112:5555

# Display resolution (Width x Height)
SCREEN_SIZE=1080x1920

# Display density (DPI)
SCREEN_DENSITY=320

# --- Waydroid Settings ---
# 1 = Waydroid: open Waydroid BEFORE running the script (container must be started manually, see README).
#     The script will try to start the session if it isn't running, but will not start the container.
# 0 = physical phone/emulator you manage yourself.
WAYDROID_MODE=0

# --- Local LLM Configuration ---
# Enable or disable the LLM stage (1=enabled, 0=disabled)
LLM_ENABLED=1

# The endpoint for your local LLM (OpenAI-compatible)
LLM_URL=http://192.168.1.110:9931/v1

# The specific model to use
LLM_MODEL=gemma-4-26B-A4B-it

# Optional: API Key if using a service like OpenAI/Anthropic
# LLM_API_KEY=your_api_key_here
